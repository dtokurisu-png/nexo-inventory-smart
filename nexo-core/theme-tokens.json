{
  "version": "2026-10-01-v3.1",
  "purpose": "Canonical semantic color tokens for Nexo Group UI. This file is the single source of truth for theme values and system semantic colors; runtime consumers must not maintain independent day/night palettes.",
  "governance": {
    "rule1": "Day and night themes must define the same semantic token names.",
    "rule2": "Text on dark surfaces must use night text tokens; text on light surfaces must use day text tokens.",
    "rule3": "Gold is primarily a night-mode emphasis color. Day mode uses Nexo blue/green/orange.",
    "rule4": "Role badges, quick settings, modals, overlays, tabs, buttons and future architecture changes must consume these semantic tokens.",
    "rule5": "Do not introduce new literal text/surface colors without first updating this token file and docs/NEXO_VISUAL_SYSTEM.md.",
    "rule6": "Generic secondary buttons use buttonSecondaryBg, buttonSecondaryText and buttonSecondaryBorder; forms and modals reuse the shared semantic surface, text and border tokens in both themes.",
    "rule7": "Theme values are injected through nexo-core/theme-runtime.js. Product modules may map selectors to semantic variables, but must not redefine day/night color values.",
    "rule8": "Product-specific semantic colors that must remain meaningful across themes live under systems and are injected by the same runtime."
  },
